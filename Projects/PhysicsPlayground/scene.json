   "camera": {
    "fovDegrees": 60,
    "near": 0.1,
    "far": 500
   },
   "script": {
    "source": "-- Smoothly follows the player from behind and above.\nlocal offset = vec3.new(0, 9, 11)\n\nreturn {\n\tOnUpdate = function(self, dt)\n\t\tlocal player = Scene.FindEntityByName(\"Player\")\n\t\tif player then\n\t\t\tlocal target = player.Transform.Translation + offset\n\t\t\tlocal current = self.Transform.Translation\n\t\t\tself.Transform.Translation = current + (target - current) * math.min(1, dt * 4)\n\t\tend\n\tend\n}\n"
   }
  },
