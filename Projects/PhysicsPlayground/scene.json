   },
   "script": {
    "source": "-- Roll the ball around: WASD / arrows to move, Space to jump, E to drop a ball, Esc to quit.\nlocal moveForce = 30\nlocal jumpImpulse = 5\n\nreturn {\n\tOnUpdate = function(self, dt)\n\t\tlocal dir = vec3.new(0, 0, 0)\n\t\tif Input.IsKeyDown(\"w\") or Input.IsKeyDown(\"up\") then dir = dir + vec3.new(0, 0, -1) end\n\t\tif Input.IsKeyDown(\"s\") or Input.IsKeyDown(\"down\") then dir = dir + vec3.new(0, 0, 1) end\n\t\tif Input.IsKeyDown(\"a\") or Input.IsKeyDown(\"left\") then dir = dir + vec3.new(-1, 0, 0) end\n\t\tif Input.IsKeyDown(\"d\") or Input.IsKeyDown(\"right\") then dir = dir + vec3.new(1, 0, 0) end\n\t\tif dir:Length() > 0 then\n\t\t\tPhysics.AddForce(self, dir:Normalized() * moveForce)\n\t\tend\n\n\t\tlocal pos = self.Transform.Translation\n\t\tif Input.WasKeyPressed(\"space\") and pos.y < 0.8 then\n\t\t\tPhysics.AddImpulse(self, vec3.new(0, jumpImpulse, 0))\n\t\tend\n\t\tif Input.WasKeyPressed(\"e\") then\n\t\t\tScene.Spawn(\"Ball\", { Translation = vec3.new(pos.x, pos.y + 3, pos.z) })\n\t\tend\n\t\tif pos.y < -15 then -- fell off the arena\n\t\t\tself.Transform.Translation = vec3.new(0, 2, 0)\n\t\t\tPhysics.SetVelocity(self, vec3.new(0, 0, 0))\n\t\tend\n\tend\n}\n"
   }
  },
